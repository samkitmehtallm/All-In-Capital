# All In Capital — environment
#
# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. No key is ever read in browser code: everything here is server-only
# except NEXT_PUBLIC_* (of which there are none by design).

# ---------------------------------------------------------------------------
# Model gateway
# ---------------------------------------------------------------------------
# The only provider currently wired. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary and fallback. The gateway spends at most 4 attempts across BOTH.
MODEL_PRIMARY=gemini-2.5-flash
MODEL_FALLBACK=gemini-2.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Force a provider. Leave unset to pick gemini when GEMINI_API_KEY is present.
# `offline` is a deterministic test double, not a model: it makes the whole
# pipeline runnable with no key and no spend. Used by tests and the load test.
# MODEL_PROVIDER=offline

# ---------------------------------------------------------------------------
# Spend
# ---------------------------------------------------------------------------
# Pauses the queue for the rest of the IST day once reached, and resumes on its
# own after midnight IST. The fund spends under INR 1,500 a month today.
DAILY_SPEND_CAP_INR=150
USD_TO_INR=88

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# `local` writes JSON under .data/ and needs no account. `supabase` uses Postgres.
DATA_BACKEND=local

# Live. The service key bypasses RLS and must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Test. A separate project: the store refuses to start if these match the live ones.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Google: sign-in, Gmail send, Calendar
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=355411754085-a073qj495fb76taudh36g8foeeefcbpe.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Sign-in allowlist. Middleware requires sign-in in production, except the OAuth
# and cron routes.
ALLOWED_EMAILS=
PARTNER_EMAILS=
MAILBOX_EMAIL=

# Secret for the signed HMAC session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Queue and tracing
# ---------------------------------------------------------------------------
# A scheduled GitHub Action calls /api/cron/queue every 5 minutes with this as a
# Bearer token, because serverless cannot keep a worker alive.
CRON_SECRET=

# Optional. Without these, spans are written to .data/traces.jsonl and step_traces
# with the same structure, so a run is still inspectable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
