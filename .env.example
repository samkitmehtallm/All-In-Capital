# All In Capital — environment
#
# Copy to .env.local and fill in. .env.local is git-ignored and must never be
# committed. No key is ever read in browser code: everything here is server-only
# except NEXT_PUBLIC_* (of which there are none by design).

# ---------------------------------------------------------------------------
# Model gateway
# ---------------------------------------------------------------------------
# Production route (brief 3: "in production, call OpenRouter directly").
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Local route (brief 3: "locally, route through Portkey"). Start the open-source
# gateway with `pnpm gateway`, which runs github.com/Portkey-AI/gateway on :8787
# and forwards to OpenRouter with automatic retries switched on. Comment out to
# call OpenRouter directly from local too.
PORTKEY_BASE_URL=http://localhost:8787/v1
PORTKEY_PROVIDER=openrouter
# Only for Portkey's hosted service, not the self-hosted gateway.
PORTKEY_API_KEY=

# Embeddings. OpenRouter has NO embedding endpoint, so retrieval needs its own
# provider: pgvector backs memo passages, the G3 portfolio conflict check, style
# examples and remembered corrections. Without this key the gateway falls back to
# deterministic stand-in vectors, reproducible but NOT semantic, and both
# `pnpm live-check` and the seed script say so rather than letting the conflict
# check look like it works. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary and fallback. The gateway spends at most 4 attempts across BOTH.
# OpenRouter namespaces model ids with the vendor; Gemini direct does not.
MODEL_PRIMARY=google/gemini-2.5-flash
MODEL_FALLBACK=google/gemini-2.5-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Force a provider: openrouter | portkey | gemini | offline. Left unset, the
# gateway prefers Portkey when its address and an OpenRouter key are both set,
# then OpenRouter, then Gemini, then offline.
# `offline` is a deterministic test double, not a model: it makes the whole
# pipeline runnable with no key and no spend. Used by tests and the load test.
# MODEL_PROVIDER=offline

# Sent as HTTP-Referer for OpenRouter attribution. Not a secret.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Spend
# ---------------------------------------------------------------------------
# Pauses the queue for the rest of the IST day once reached, and resumes on its
# own after midnight IST. The fund spends under INR 1,500 a month today.
DAILY_SPEND_CAP_INR=150
USD_TO_INR=88

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# `local` writes JSON under .data/ and needs no account. `supabase` uses Postgres.
DATA_BACKEND=local

# Live. The service key bypasses RLS and must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Test. A separate project: the store refuses to start if these match the live ones.
SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Google: sign-in, Gmail send, Calendar
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=355411754085-a073qj495fb76taudh36g8foeeefcbpe.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Sign-in allowlist. Middleware requires sign-in in production, except the OAuth
# and cron routes.
ALLOWED_EMAILS=
PARTNER_EMAILS=
MAILBOX_EMAIL=

# Secret for the signed HMAC session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Queue and tracing
# ---------------------------------------------------------------------------
# A scheduled GitHub Action calls /api/cron/queue every 5 minutes with this as a
# Bearer token, because serverless cannot keep a worker alive.
CRON_SECRET=

# Optional. Without these, spans are written to .data/traces.jsonl and step_traces
# with the same structure, so a run is still inspectable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
